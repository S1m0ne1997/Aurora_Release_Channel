# Copia questo file in .env (accanto a docker-compose.yml) e modifica i valori.

# Dominio con un record DNS di tipo A verso l'IP del server: certificato
# Let's Encrypt automatico sulle porte 80 e 443. Vuoto = solo IP, con un
# certificato proprio da confermare nel client, sulla porta PORT.
DOMAIN=
PORT=8080

# IP pubblico del server (obbligatorio)
PUBLIC_IP=203.0.113.10

# Porta UDP unica per tutto l'audio
UDP_PORT=7882

# Canali iniziali (poi si gestiscono dall'app) e massimo utenti per canale (0 = nessun limite)
ROOMS=Generale,Gaming,Musica,AFK
MAX_PER_ROOM=0

# Chiave dei file di stato cifrati: generala una volta con
#   openssl rand -hex 32
# e conservala a parte. Vuota = il server la crea in data/state/key (meno
# sicuro: un backup di data/ contiene anche la chiave).
AURORA_STATE_KEY=

# Aggiornamento automatico dal canale stabile: "off" per spegnerlo
#AURORA_UPDATE_REPO=off
